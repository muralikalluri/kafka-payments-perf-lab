# Copy to .env for local use. Placeholder values only; never commit real credentials.
POSTGRES_DB=payments
POSTGRES_USER=payments
POSTGRES_PASSWORD=change-me-local-only
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-local-only
# Host ports (chosen to avoid clashing with other local projects)
POSTGRES_PORT=5442
REDIS_PORT=6390
GRAFANA_PORT=3030
# Token for the tuned-only lab admin endpoint (placeholder; never a real secret)
LAB_ADMIN_TOKEN=lab-admin-local-only
# Webhook simulator (F-05), tracing and topic replication, all optional
WEBHOOK_LATENCY_MS=5
WEBHOOK_FAILURE_RATE=0
TRACING_SAMPLING=0.0
LAB_TOPIC_REPLICAS=3
